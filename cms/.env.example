# ---------------------------------------------------------------------------
# Lumina / Advanced Directus - deployment environment
# Copy to .env, then replace every "replace-with..." value.
# ---------------------------------------------------------------------------

# Directus secrets
DIRECTUS_KEY=replace-with-a-random-64-char-key
DIRECTUS_SECRET=replace-with-a-random-64-char-secret
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-strong-password
DIRECTUS_ADMIN_TOKEN=replace-with-a-random-admin-token

# Browser-facing Directus URL (used by the Studio and notes in the docs).
# On the Pi this is usually http://<pi-lan-ip>:8055
DIRECTUS_PUBLIC_URL=http://localhost:8055

# Optional explicit WebSocket URL. Leave empty to derive it from the request
# host, which is what the Pi/LAN setup uses.
DIRECTUS_WS_URL=

# Shared secret between Directus Flows and the Next.js mock APIs
LAB_SECRET=replace-with-a-random-lab-secret

# Browser origin allowed to call Directus (the Next.js app)
WEB_ORIGIN=http://localhost:3000

# URL Directus uses to reach the mock APIs from inside its container.
# In Docker Compose use http://web:3000.
# If Directus runs in Docker while Next runs on the host, use
# http://host.docker.internal:3000 instead.
MOCK_API_URL=http://web:3000

# ---------------------------------------------------------------------------
# Advanced Payload course
# ---------------------------------------------------------------------------
# Payload runs on the host in this workspace (port 3002 by default).
# PAYLOAD_URL is used by the Next.js server inside Docker.
# PAYLOAD_PUBLIC_URL is used by the browser for iframe previews.
PAYLOAD_URL=http://host.docker.internal:3002
PAYLOAD_PUBLIC_URL=http://localhost:3002
PAYLOAD_API_KEY=replace-with-the-payload-service-api-key

# ---------------------------------------------------------------------------
# Advanced KeystoneJS course
# ---------------------------------------------------------------------------
# Keystone runs on the host at port 3003.
KEYSTONE_URL=http://host.docker.internal:3003
KEYSTONE_PUBLIC_URL=http://localhost:3003
KEYSTONE_SECRET=replace-with-the-shared-keystone-lumina-secret
