}

model Lesson {
  id             String      @id @default(cuid())
  section        Section?    @relation("Lesson_section", fields: [sectionId], references: [id])
  sectionId      String?     @map("section")
  slug           String      @unique @default("")
  title          String      @default("")
  sort           Int?        @default(0)
  track          String?     @default("foundations")
  outcome        String      @default("")
  mentalModel    Json?
  lab            Json?
  takeaway       String      @default("")
  knowledgeCheck Json?
  deepDive       Json?
  published      Boolean     @default(true)
  components     Component[] @relation("Component_lesson")

  @@index([sectionId])
}

model Component {
  id           String    @id @default(cuid())
  name         String    @default("")
  description  String    @default("")
  lesson       Lesson?   @relation("Component_lesson", fields: [lessonId], references: [id])
  lessonId     String?   @map("lesson")
  lessonSlug   String    @default("")
  ownerSession String    @default("")
  surface      String?   @default("public")
  kind         String    @default("")
  status       String?   @default("draft")
  featured     Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())
  html         String    @default("")
  css          String    @default("")
  js           String    @default("")
  content      Json?
  tokens       Json?

  @@index([lessonId])
  @@index([lessonSlug])
  @@index([ownerSession])
  @@index([kind])
}

model ComponentCatalog {
  id            String @id @default(cuid())
  key           String @unique @default("default")
  version       String @default("1")
